% Compiler Options for rebar
{erl_opts, [{parse_transform, lager_transform}, debug_info, {src_dirs, ["src"]}]}.

% Dependencies
{deps, [
    {goldrush, {git, "https://github.com/DeadZen/goldrush.git", {tag, "0.1.9"}}},
    {lager, {git, "https://github.com/erlang-lager/lager.git", {tag, "3.8.0"}}},
    {meck, {git, "https://github.com/eproxus/meck.git", {tag, "0.9.2"}}},
    {jsx, {git, "https://github.com/talentdeficit/jsx.git", {tag, "v2.8.3"}}}
]}.

{cover_enabled, true}.
{cover_print_enable, true}.

{eunit_opts, [verbose, {report, {eunit_surefire, [{dir, "."}]}}]}.
